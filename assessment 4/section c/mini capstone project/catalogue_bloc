import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:equatable/equatable.dart';
import 'package:connectivity_plus/connectivity_plus.dart';
import 'book.dart';
import 'api_service.dart';
import 'firestore_service.dart';

abstract class CatalogueEvent extends Equatable {
  const CatalogueEvent();
  @override
  List<Object> get props => [];
}

class FetchCatalogue extends CatalogueEvent {}

abstract class CatalogueState extends Equatable {
  const CatalogueState();
  @override
  List<Object> get props => [];
}

class CatalogueLoading extends CatalogueState {}

class CatalogueLoaded extends CatalogueState {
  final List<Book> books;
  final bool isOffline;
  const CatalogueLoaded(this.books, {this.isOffline = false});

  @override
  List<Object> get props => [books, isOffline];
}

class CatalogueError extends CatalogueState {
  final String message;
  const CatalogueError(this.message);

  @override
  List<Object> get props => [message];
}

class CatalogueBloc extends Bloc<CatalogueEvent, CatalogueState> {
  final ApiService apiService;
  final FirestoreService firestoreService;

  CatalogueBloc({required this.apiService, required this.firestoreService})
      : super(CatalogueLoading()) {
    on<FetchCatalogue>((event, emit) async {
      emit(CatalogueLoading());
      try {
        final connectivityResult = await Connectivity().checkConnectivity();
        if (connectivityResult != ConnectivityResult.none) {
          final books = await apiService.fetchBooks();
          await firestoreService.cacheCatalogue(books);
          emit(CatalogueLoaded(books));
        } else {
          final cachedBooks = await firestoreService.getCachedCatalogue();
          if (cachedBooks.isNotEmpty) {
            emit(CatalogueLoaded(cachedBooks, isOffline: true));
          } else {
            emit(const CatalogueError("No internet connection and no cached data found."));
          }
        }
      } catch (e) {
        try {
          final cachedBooks = await firestoreService.getCachedCatalogue();
          if (cachedBooks.isNotEmpty) {
            emit(CatalogueLoaded(cachedBooks, isOffline: true));
          } else {
            emit(CatalogueError("Failed to fetch data: $e"));
          }
        } catch (_) {
          emit(CatalogueError("Error: $e"));
        }
      }
    });
  }
}
